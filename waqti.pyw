            w.protocol("WM_DELETE_WINDOW", close_w)
            row = tk.Frame(w, bg=CARD)
            row.pack(fill="x", pady=(16, 0))
            btn(row, "حفظ", save_w, bg=GOOD).pack(side="right", padx=4)
