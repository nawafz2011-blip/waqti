                desc = "، ".join(f"{n} = {' + '.join(accs)}" for n, accs in chosen.items()) or "ما فيه"
                self.log("settings", f"الكبير ربط الحسابات: {desc}" + (f"، وبدون حد: {', '.join(new_free)}" if new_free else ""),
