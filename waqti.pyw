            tk.Label(w, text="اضغط على الزر جنب كل حساب واختر صاحبه. إذا دخل حسابه، يبدأ وقته على طول.",
                     font=(FONT, 11), bg=CARD, fg=MUTED).pack(anchor="e", pady=(2, 12))
