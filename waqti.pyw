    # ---------- auto update
    def check_update(self):
        if self.update_ready:
            self.apply_update()
        elif UPDATE_URL and not getattr(sys, "frozen", False):
            threading.Thread(target=self._fetch_update, daemon=True).start()
        self.root.after(UPDATE_EVERY_SEC * 1000, self.check_update)

    def _fetch_update(self):
        try:
            url = f"{UPDATE_URL}?t={int(time.time())}"
            req = urllib.request.Request(url, headers={"Cache-Control": "no-cache"})
            with urllib.request.urlopen(req, timeout=15) as r:
                code = r.read().decode("utf-8")
            m = re.search(r"^VERSION = (\d+)", code, re.M)
            if not m or int(m.group(1)) <= VERSION:
                return
            compile(code, "waqti", "exec")  # نتأكد إن الكود سليم قبل لا نبدل
            self.update_ready = (int(m.group(1)), code)
        except Exception:
            pass

    def apply_update(self):
        if self.dialogs:              # لا نعيد التشغيل والكبير فاتح الإعدادات
            return
        ver, code = self.update_ready
        path = os.path.abspath(__file__)
        try:
            tmp = path + ".new"
            with open(tmp, "w", encoding="utf-8", newline="\n") as f:
                f.write(code)
            try:
                os.chmod(path, stat.S_IWRITE | stat.S_IREAD)  # لو الملف للقراءة بس
            except Exception:
                pass
            try:
                os.replace(tmp, path)
            except PermissionError:      # المجلد مقفول ضد الحذف: نكتب الكود فوق الملف مباشرة
                with open(path, "w", encoding="utf-8", newline="\n") as f:
                    f.write(code)
        except Exception as ex:
            self.update_ready = None
            if getattr(self, "update_failed_ver", None) != ver:   # نسجل الفشل مرة وحدة بس
                self.update_failed_ver = ver
                self.log("update_fail", f"فشل التحديث: {ex}")
            return
        self.state["resume"] = {"name": self.active, "grace_left": self.grace_left,
                                "warned": self.warned, "at": time.time()}
        self.save_state()
        global _instance_lock
        try:
            _instance_lock.close()
        except Exception:
            pass
        flags = 0x00000008 if IS_WIN else 0  # DETACHED_PROCESS
        subprocess.Popen([sys.executable, path], creationflags=flags, close_fds=True)
        self.root.destroy()

    def continue_session(self, resume):
        self.active = resume["name"]
        self.grace_left = resume.get("grace_left")
        self.warned = bool(resume.get("warned"))
        self.show_timer()

    # ---------- data
    def _disk_state(self):
        try:
            st = read_json_strict(STATE_PATH) or {}
        except Unreadable:               # مشغول/خربان: نكمل من آخر نسخة عندنا بدل ما نصفّر الأوقات
            st = copy.deepcopy(getattr(self, "base", None) or {})
        st.setdefault("active_by", {})
        st.setdefault("resume_by", {})
        for k in ("active", "resume"):          # من النسخ القديمة
            if k in st:
                if st[k]:
                    st[k + "_by"][USER] = st[k]
                del st[k]
        for k in ("used", "bonus", "nobody", "week", "wd"):
            st.setdefault(k, {})
        return st

    def state_op(self, fn):
        """تعديل مباشر على الملف المشترك (للدور والريست)"""
        self.sync_state(op=fn)

    def sync_state(self, op=None):
        """نحفظ تغييراتنا وناخذ تغييرات الحسابات الثانية (كل حساب له نسخة من البرنامج)"""
        with file_lock():
            disk = self._disk_state()
            mine = self.state
            if mine:
                if mine.get("date") and (disk.get("date") or "") < mine["date"]:
                    keep = {k: disk[k] for k in ("round", "reset_fails", "reset_locked", "open", "penalty", "skipped", "blocked", "cmds_done", "week", "wd", "week_id", "report_sent", "remote_fails", "remote_lock", "round_announced", "finished_at", "roster_fb", "say_shown", "running_by", "closed_by") if k in disk}
                    disk = {"date": mine["date"], "used": {}, "bonus": {}, "nobody": {},
                            "active_by": disk["active_by"], "resume_by": disk["resume_by"], **keep}
                if disk.get("date") == mine.get("date"):
                    base = self.base if self.base.get("date") == mine.get("date") else {}
                    for k in ("used", "bonus", "nobody", "week", "wd"):
                        cur, old = mine.get(k, {}), base.get(k, {})
                        for n in set(cur) | set(old):
                            d = cur.get(n, 0) - old.get(n, 0)
                            if d:
                                disk[k][n] = disk[k].get(n, 0) + d
                                if disk[k][n] == 0 or (k == "used" and n not in cur and abs(disk[k][n]) < 1):
                                    disk[k].pop(n, None)
                disk["active_by"][USER] = mine.get("active")
                if mine.get("resume"):
                    disk["resume_by"][USER] = mine["resume"]
                else:
                    disk["resume_by"].pop(USER, None)
            if op:
                op(disk)
            if mine or disk.get("date") or op:
                save_json(STATE_PATH, disk, backup=True)
        self.base = copy.deepcopy(disk)
        st = copy.deepcopy(disk)
        st["active"] = st["active_by"].get(USER)
        st["resume"] = st["resume_by"].get(USER)
        self.state = st

    def save_state(self):
        self.sync_state()

    def restore_from_backup(self):
        """لو أحد حذف ملفات البرنامج: نرجّع الإعدادات (والأوقات لو نفس اليوم) من النسخة اللي في القاعدة"""
        try:
            d = fb_req("GET", backup_path(), timeout=8)
            data = json.loads(d["m"]) if d and d.get("m") else None
        except Exception:
            return None
        cfg = (data or {}).get("cfg")
        if not cfg or looks_default(cfg) or not cfg.get("players"):
            return None
        self.cfg = cfg
        save_json(CONFIG_PATH, self.cfg, backup=True)
        st = data.get("state") or {}
        h = int(cfg.get("day_start_hour", 4))
        today = (datetime.datetime.now() - datetime.timedelta(hours=h)).date().isoformat()
        if st.get("date") == today:
            def op(disk):
                for k in BACKUP_STATE_KEYS:
                    if k in st:
                        disk[k] = st[k]
            with file_lock():
                disk = load_json(STATE_PATH, {})
                op(disk)
                save_json(STATE_PATH, disk, backup=True)
            return "all"
        return "cfg"

    def backup_soon(self, delay=3000):
        """نسخة احتياطية في القاعدة (بعد ثواني، ومرة وحدة لو صار أكثر من تغيير)"""
        if getattr(self, "_bk_pending", False):
            return
        self._bk_pending = True

        def go():
            self._bk_pending = False
            cfg = {k: v for k, v in self.cfg.items() if not k.startswith("_")}
            if looks_default(cfg):
                return                       # ما نكتب إعدادات افتراضية فوق النسخة الزينة
            st = {k: self.state.get(k) for k in BACKUP_STATE_KEYS if k in self.state}
            key_c = hashlib.sha256(json.dumps(cfg, sort_keys=True, ensure_ascii=False).encode()).hexdigest()
            key_s = hashlib.sha256(json.dumps(st, sort_keys=True, ensure_ascii=False).encode()).hexdigest()
            last = getattr(self, "_bk_last", ("", "", 0))
            if key_c == last[0] and (key_s == last[1] or time.time() - last[2] < 60):
                return                       # الأوقات وحدها: مرة بالدقيقة بالكثير
            self._bk_last = (key_c, key_s, time.time())
            body = json.dumps({"v": 1, "cfg": cfg, "state": st, "user": USER}, ensure_ascii=False)

            def run():
                try:
                    fb_req("PUT", backup_path(), fb_entry(body), timeout=20)
                except Exception:
                    self._bk_last = ("", "", 0)
            threading.Thread(target=run, daemon=True).start()
        try:
            self.root.after(delay, go)
        except Exception:
            self._bk_pending = False

    def protect_files(self):
        if data_dir_protected():
            self.info("مقفول ✅", "ملفات البرنامج مقفولة من قبل: ما أحد يقدر يحذفها.")
            return
        v, _ = self.ask("🔒 منع حذف الملفات",
                        "بعدها ما أحد يقدر يحذف ملفات البرنامج (إلا حساب مسؤول Admin).\n"
                        "ويندوز بيسألك «هل تسمح لهذا التطبيق بإجراء تغييرات؟» اضغط «نعم».",
                        [("كمّل", "y"), ("إلغاء", None)])
        if not v:
            return
        if not protect_data_dir():
            self.info("ما تم", "لازم توافق على رسالة ويندوز، ومن حساب مسؤول (Admin).")
            return

        def check(n=0):
            if data_dir_protected():
                self.log("protected", "🔒 الكبير قفل ملفات البرنامج ضد الحذف", None, admin=True)
                self.info("تم ✅", "ملفات البرنامج مقفولة: ما أحد يقدر يحذفها.")
            elif n < 15:
                self.root.after(1000, lambda: check(n + 1))
            else:
                self.info("ما تم", "ما قدرت أقفلها. تأكد إنك ضغطت «نعم» في رسالة ويندوز.")
        self.root.after(1500, check)

    def restore_from_link(self):
        """استرجاع يدوي: كود رابط المنظم + الرمز القديم ← اللاعبين والإعدادات والرمز من القاعدة"""
        v, vals = self.ask("♻️ استرجاع الإعدادات",
                           "لو انمسحت الإعدادات: اكتب الكود اللي في رابطك (بعد waqti-admin-) أو الصق الرابط كامل،\n"
                           "واكتب رمزك القديم. يرجع اللاعبين وأوقاتهم وحساباتهم والإعدادات ورمزك.",
                           [("استرجع", True), ("إلغاء", None)],
                           fields=[("الكود أو الرابط", "", False), ("رمزك القديم", "", True)])
        if not v:
            return
        text, oldpin = vals[0].strip(), vals[1]
        q = urllib.parse.parse_qs(urllib.parse.urlparse(text).query) if "?" in text else {}
        admin = (q.get("a") or [text])[0].strip()
        if not admin.startswith("waqti-admin-"):
            admin = "waqti-admin-" + admin
        if not re.fullmatch(r"waqti-admin-[0-9a-z]{6,40}", admin) or not oldpin.strip():
            self.info("خطأ", "اكتب الكود (مثل 6203d8dcdc2f) ورمزك القديم.")
            return
        try:
            r = fb_req("GET", fb_path(admin + "-roster"), timeout=15)
            info = json.loads(r["m"]) if r and r.get("m") else None
            oks = fb_items(fb_req("GET", fb_path(admin + "-ok"), timeout=15))
        except Exception as ex:
            self.info("ما قدرت", f"تأكد من النت.\n{ex}")
            return
        if not info or not info.get("players"):
            self.info("ما لقيت شي", "ما لقيت إعدادات محفوظة بهالكود. تأكد منه.")
            return
        ph = hash_pin(oldpin)
        cmds = []
        for _, m, _t in oks:
            try:
                cmds.append(json.loads(m))
            except Exception:
                pass
        signed = [d for d in cmds if d.get("p") and d.get("cmd")]
        good = any(d.get("p") == hashlib.sha256((ph + f"{d['cmd']}|{d.get('who', '')}|{d.get('ts', '')}").encode()).hexdigest()
                   for d in signed)
        if signed and not good:
            self.log("restore_fail", "⚠️ أحد حاول يسترجع الإعدادات برمز غلط", None, admin=True)
            self.info("الرمز غلط", "رمزك القديم مو صحيح.")
            return
        self.cfg["admin_topic"] = admin
        if q.get("t"):
            self.cfg["ntfy_topic"] = q["t"][0]
        self.cfg["admin_pin"] = ph
        self.cfg["players"] = [{"name": p["name"], "daily_minutes": int(p.get("mins", 120)), "pin": "",
                                "windows_user": p.get("win", "")} for p in info["players"]]
        for k, val in (info.get("settings") or {}).items():
            if k in DEFAULT_CONFIG and val is not None:
                self.cfg[k] = val
        self.save_cfg()
        self.publish_roster(force=True)
        self.log("restored", "♻️ الكبير رجّع الإعدادات (اللاعبين والرمز) من القاعدة", None, admin=True)
        self.info("رجع كل شي ✅",
                  "رجعوا اللاعبين وأوقاتهم وحساباتهم والإعدادات، ورمزك رجع زي ما كان.\n\n"
                  "• رموز اللاعبين انمسحت: حطها من جديد (الإعدادات ← تعديل).\n"
                  "• رابط الإخوان تغيّر: أرسله لهم من «رابط الإشعارات».\n"
                  "• حدّث رابطك في تطبيق الجوال (ضغطة طويلة ← تغيير الرابط) من النافذة الجاية.")
        self.show_admin_channel()

    def save_cfg(self):
        self.cfg.pop("_fresh", None)
        save_json(CONFIG_PATH, self.cfg, backup=True)
        self.backup_soon()

    def log(self, kind, text, player=None, notify=False, admin=False):
        e = {"t": datetime.datetime.now().isoformat(timespec="seconds"),
             "kind": kind, "player": player, "text": text}
        try:
            with open(LOG_PATH, "a", encoding="utf-8") as f:
                f.write(json.dumps(e, ensure_ascii=False) + "\n")
        except Exception:
            pass
        if notify:
            notify_all(self.cfg, f"⏱ وقتي\n{text}\nالساعة {now_hm()}")
        if admin:
            ntfy_admin_send(self.cfg, "وقتي: تنبيه للمنظم", f"{text}\nالساعة {now_hm()}")

    def today(self):
        h = int(self.cfg.get("day_start_hour", 4))
        return (datetime.datetime.now() - datetime.timedelta(hours=h)).date().isoformat()

    def ensure_today(self):
        t = self.today()
        if self.state.get("date") != t:
            self.state = {"date": t, "used": {}, "bonus": {}, "nobody": {},
                          "week": self.state.get("week", {}), "week_id": self.state.get("week_id"),
                          "wd": self.state.get("wd", {}),
                          "active": self.state.get("active"), "resume": self.state.get("resume")}
            self.save_state()
            return True
        for k in ("used", "bonus", "nobody", "week", "wd"):
            self.state.setdefault(k, {})
        return False

    def player(self, name):
        for p in self.cfg["players"]:
            if p["name"] == name:
                return p
        return None

    def remaining(self, name):
        p = self.player(name)
        base = int(p["daily_minutes"]) * 60 if p else 0
        return base + self.state["bonus"].get(name, 0) - self.state["used"].get(name, 0)

    # ---------- dialogs
    def ask(self, title, msg, buttons, fields=None):
        d = tk.Toplevel(self.root)
        d.title(title)
        d.configure(bg=CARD, padx=26, pady=22)
        d.attributes("-topmost", True)
        d.resizable(False, False)
        result = {"v": None, "vals": []}
        entries = []

        def close(v):
            result["v"] = v
            result["vals"] = [e.get() for e in entries]
            try:
                d.grab_release()
            except Exception:
                pass
            if d in self.dialogs:
                self.dialogs.remove(d)
            d.destroy()

        d.protocol("WM_DELETE_WINDOW", lambda: close(None))
        tk.Label(d, text=title, font=(FONT, 16, "bold"), bg=CARD, fg=FG).pack(anchor="e")
        if msg:
            tk.Label(d, text=msg, font=(FONT, 12), bg=CARD, fg=MUTED, justify="right",
                     wraplength=440).pack(anchor="e", pady=(6, 12))
        for label, default, secret in fields or []:
            row = tk.Frame(d, bg=CARD)
            row.pack(fill="x", pady=4)
            tk.Label(row, text=label, font=(FONT, 12), bg=CARD, fg=FG).pack(side="right")
            e = tk.Entry(row, font=(FONT, 13), justify="right", width=22, show="•" if secret else "")
            e.insert(0, str(default))
            e.pack(side="left", padx=(0, 12))
            entries.append(e)
        bf = tk.Frame(d, bg=CARD)
        bf.pack(fill="x", pady=(16, 0))
        default_v = None
        for lbl, val in buttons:
            if val is not None and default_v is None:
                default_v = val
            btn(bf, lbl, lambda v=val: close(v), bg=DIM if val is None else ACCENT).pack(side="right", padx=4)
        d.bind("<Return>", lambda e: close(default_v))
        d.bind("<Escape>", lambda e: close(None))

        self.dialogs.append(d)
        d.update_idletasks()
        w, h = d.winfo_reqwidth(), d.winfo_reqheight()
        sw, sh = self.root.winfo_screenwidth(), self.root.winfo_screenheight()
        d.geometry(f"+{(sw - w) // 2}+{(sh - h) // 3}")
        d.lift()
        try:
            d.wait_visibility()
            d.grab_set()
        except Exception:
            pass
        d.focus_force()
        if entries:
            entries[0].focus_set()
            entries[0].select_range(0, "end")
        self.root.wait_window(d)
        return result["v"], result["vals"]

