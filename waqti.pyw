def load_config(fallback=None):
    """الإعدادات. لو الملف موجود وما انقرى: نرجع آخر نسخة عندنا ولا نكتب فوقه (قبل كان يرجع الإعدادات الافتراضية ويمسح كل شي)"""
    try:
        cfg = read_json_strict(CONFIG_PATH)
    except Unreadable:
        if fallback is not None:
            return fallback
        cfg = None
        for _ in range(50):              # أول تشغيل: ننتظر لين ينقرى
            time.sleep(0.2)
            try:
                cfg = read_json_strict(CONFIG_PATH)
                break
            except Unreadable:
                pass
        if cfg is None and os.path.exists(CONFIG_PATH):
            raise
    fresh = cfg is None
    cfg = copy.deepcopy(DEFAULT_CONFIG) if fresh else cfg
    changed = fresh
    for k, v in DEFAULT_CONFIG.items():
        if k not in cfg:
            cfg[k] = copy.deepcopy(v)
            changed = True
    for k, make in (("ntfy_topic", new_topic), ("sign_key", lambda: secrets.token_hex(32)),
                    ("admin_topic", lambda: "waqti-admin-" + secrets.token_hex(6))):
        if not cfg.get(k):
            cfg[k] = make()
            changed = True
    if changed:
        save_json(CONFIG_PATH, cfg, backup=True)
    if fresh:
        cfg["_fresh"] = True             # انصنعت الحين: نشيك على النسخة الاحتياطية في القاعدة (ما ينحفظ بالملف)
    return cfg


def read_log(limit=200):
    try:
        with open(LOG_PATH, "r", encoding="utf-8") as f:
            lines = f.readlines()[-limit:]
    except Exception:
        return []
    out = []
    for ln in lines:
        try:
            out.append(json.loads(ln))
        except Exception:
            pass
    return list(reversed(out))  # newest first


def fmt(sec):
    sec = max(0, int(sec))
    h, rem = divmod(sec, 3600)
    m, s = divmod(rem, 60)
    return f"{h}:{m:02d}:{s:02d}" if h else f"{m:02d}:{s:02d}"


def parse_hours(text):
    """يحول الساعات المكتوبة (2 أو 1.5 أو ١٫٥) إلى دقايق. يرجع None إذا غلط."""
    t = text.strip().translate(str.maketrans("٠١٢٣٤٥٦٧٨٩٫،,", "0123456789...")).replace("ساعة", "").replace("ساعات", "").strip()
    try:
        return int(round(float(t) * 60))
    except ValueError:
        return None


def hm_minutes(h, m):
    """ساعات + دقايق من خانتين → دقايق. يرجع None إذا غلط"""
    tr = str.maketrans("٠١٢٣٤٥٦٧٨٩٫", "0123456789.")
    h, m = (h or "0").strip().translate(tr) or "0", (m or "0").strip().translate(tr) or "0"
    try:
        return int(round(float(h) * 60 + float(m)))
    except ValueError:
        return None


def hours_num(minutes):
    h = minutes / 60
    return str(int(h)) if h == int(h) else f"{h:.2f}".rstrip("0")


def dur(minutes):
    """مدة بالكلام: ساعة، ساعتين، 3 ساعات، نص ساعة، ساعة و 15 دقيقة"""
    m = abs(int(minutes))
    if m == 0:
        return "أقل من دقيقة"
    h, r = divmod(m, 60)
    hs = {0: "", 1: "ساعة", 2: "ساعتين"}.get(h, f"{h} ساعات" if h <= 10 else f"{h} ساعة")
    if r == 0:
        return hs
    if not h:
        return {30: "نص ساعة", 15: "ربع ساعة"}.get(r, f"{r} دقيقة")
    return f"{hs} و{'نص' if r == 30 else f' {r} دقيقة'}"


def h12(dt):
    """6:32 م بدل 18:32"""
    h = dt.hour % 12 or 12
    return f"{h}:{dt.minute:02d} {'ص' if dt.hour < 12 else 'م'}"


def now_hm():
    return h12(datetime.datetime.now())


def entry_time(e):
    try:
        d = datetime.datetime.fromisoformat(e["t"])
        return d.strftime("%d/%m") + "  " + h12(d)
    except Exception:
        return ""


# ---------------------------------------------------------------- telegram

def telegram_send_sync(cfg, text):
    token = (cfg.get("telegram_token") or "").strip()
    chat = (cfg.get("telegram_chat_id") or "").strip()
    if not token or not chat:
        return False, "ما فيه إعدادات تيليجرام"
    try:
        url = f"https://api.telegram.org/bot{token}/sendMessage"
        data = urllib.parse.urlencode({"chat_id": chat, "text": text}).encode()
        with urllib.request.urlopen(url, data=data, timeout=10) as r:
            ok = json.loads(r.read().decode()).get("ok", False)
        return ok, "" if ok else "تيليجرام رفض الرسالة"
    except Exception as ex:
        return False, str(ex)


def notify_all(cfg, text):
    cfg = copy.deepcopy(cfg)

    def run():
        ntfy_send_sync(cfg, text)
        telegram_send_sync(cfg, text)
    threading.Thread(target=run, daemon=True).start()


