# ---- ختم الرسائل (Ed25519): البرنامج يختم، وموقع الرسائل يعرض المختوم بس
_P = 2 ** 255 - 19
_L = 2 ** 252 + 27742317777372353535851937790883648493
_D = -121665 * pow(121666, _P - 2, _P) % _P
_BY = 4 * pow(5, _P - 2, _P) % _P


def _xrecover(y):
    xx = (y * y - 1) * pow(_D * y * y + 1, _P - 2, _P)
    x = pow(xx, (_P + 3) // 8, _P)
    if (x * x - xx) % _P:
        x = x * pow(2, (_P - 1) // 4, _P) % _P
    return _P - x if x % 2 else x


_BX = _xrecover(_BY)
_BASE = (_BX, _BY, 1, _BX * _BY % _P)


def _padd(a, b):
    x1, y1, z1, t1 = a
    x2, y2, z2, t2 = b
    A = (y1 - x1) * (y2 - x2) % _P
    B = (y1 + x1) * (y2 + x2) % _P
    C = t1 * 2 * _D * t2 % _P
    Dd = z1 * 2 * z2 % _P
    E, F, G, H = B - A, Dd - C, Dd + C, B + A
    return (E * F % _P, G * H % _P, F * G % _P, E * H % _P)


def _pmul(k, pt):
    q = (0, 1, 1, 0)
    while k:
        if k & 1:
            q = _padd(q, pt)
        pt = _padd(pt, pt)
        k >>= 1
    return q


def _penc(pt):
    x, y, z, _ = pt
    zi = pow(z, _P - 2, _P)
    x, y = x * zi % _P, y * zi % _P
    return (y | ((x & 1) << 255)).to_bytes(32, "little")


def ed25519_keys(seed):
    h = hashlib.sha512(seed).digest()
    a = int.from_bytes(h[:32], "little")
    a = (a & ((1 << 254) - 8)) | (1 << 254)
    return a, h[32:], _penc(_pmul(a, _BASE))


def ed25519_sign(seed, msg):
    a, prefix, pub = ed25519_keys(seed)
    r = int.from_bytes(hashlib.sha512(prefix + msg).digest(), "little") % _L
    R = _penc(_pmul(r, _BASE))
    k = int.from_bytes(hashlib.sha512(R + pub + msg).digest(), "little") % _L
    return R + ((r + k * a) % _L).to_bytes(32, "little")


def msgs_link(cfg):
    pub = ed25519_keys(bytes.fromhex(cfg["sign_key"]))[2].hex()
    return f"{MSGS_URL}?t={cfg['ntfy_topic']}&k={pub}"


NET = {"ok_at": 0.0, "err_at": 0.0, "err": "", "pause_until": 0.0}


def net_ok():
    NET["ok_at"] = time.time()


def net_err(ex):
    NET["err_at"] = time.time()
    NET["err"] = f"{type(ex).__name__}: {ex}"[:90]
    if "429" in str(ex):                      # ntfy يقول «كثير»: نوقف الإضافي نص ساعة
        NET["pause_until"] = time.time() + 1800


FB_URL = "https://waqti-47a62-default-rtdb.europe-west1.firebasedatabase.app"


def fb_key(topic):
    """اسم المكان في قاعدة Firebase (القاعدة تقبل الأسماء الطويلة بس، عشان ما ينخمن)"""
    return topic if len(topic) >= 20 else topic + "-pub-feed"


def fb_path(topic):
    """القنوات القديمة لـ ntfy ← مكانها في Firebase. ردود الأوامر كلها تحت مكان واحد"""
    if "-res-" in topic:
        base, rid = topic.split("-res-", 1)
        return f"r/{fb_key(base + '-res')}/{rid}"
    return "r/" + fb_key(topic)


def fb_req(method, path, data=None, timeout=15):
    body = None if data is None else json.dumps(data, ensure_ascii=False).encode("utf-8")
    req = urllib.request.Request(f"{FB_URL}/{path}.json", data=body, method=method,
                                 headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        txt = r.read().decode("utf-8", "ignore")
    return json.loads(txt) if txt else None


def fb_entry(text, title="", click="", prio=3):
    e = {"m": text, "t": {".sv": "timestamp"}}
    if title:
        e["ti"] = title
    if click:
        e["c"] = click
    if prio != 3:
        e["p"] = prio
    return e


def ntfy_send_sync(cfg, text):
    """الرسالة تروح لقاعدتنا (Firebase) مختومة، وموقعنا على GitHub يعرضها"""
    if not cfg.get("ntfy_topic"):
        return False, "ما فيه رابط"
    try:
        ts = int(time.time())
        sig = ed25519_sign(bytes.fromhex(cfg["sign_key"]), f"{ts}|{text}".encode("utf-8")).hex()
        fb_req("POST", fb_path(cfg["ntfy_topic"]), fb_entry(text, "وقتي", f"{msgs_link(cfg)}#s={sig}&ts={ts}"))
        net_ok()
        return True, ""
    except Exception as ex:
        net_err(ex)
        return False, str(ex)


@contextlib.contextmanager
def file_lock(name="state.lock"):
    if IS_WIN:                           # قفل داخل ملف ثابت (ما ينحذف): يشتغل حتى لو المجلد مقفول ضد الحذف
        import msvcrt
        fh = None
        try:
            fh = open(os.path.join(DATA_DIR, name.replace(".lock", ".lk")), "a+")
            for _ in range(200):
                try:
                    fh.seek(0)
                    msvcrt.locking(fh.fileno(), msvcrt.LK_NBLCK, 1)
                    break
                except OSError:
                    time.sleep(0.05)
            else:
                fh.close()
                fh = None
        except Exception:
            fh = None
        try:
            yield
        finally:
            if fh is not None:
                try:
                    fh.seek(0)
                    msvcrt.locking(fh.fileno(), msvcrt.LK_UNLCK, 1)
                except Exception:
                    pass
                fh.close()
        return
    path = os.path.join(DATA_DIR, name)
    fd = None
    for _ in range(100):
        try:
            fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
            break
        except FileExistsError:
            try:
                if time.time() - os.path.getmtime(path) > 10:
                    os.remove(path)
            except Exception:
                pass
            time.sleep(0.05)
        except Exception:
            break
    try:
        yield
    finally:
        if fd is not None:
            os.close(fd)
            try:
                os.remove(path)
            except Exception:
                pass


def session_active():
    """هل هذا الحساب هو اللي قدام الشاشة الحين؟ (مو مقفل ومو حساب ثاني)"""
    if not IS_WIN:
        return True
    try:
        import ctypes
        k = ctypes.windll.kernel32
        sid = ctypes.c_ulong()
        k.ProcessIdToSessionId(k.GetCurrentProcessId(), ctypes.byref(sid))
        if k.WTSGetActiveConsoleSessionId() != sid.value:
            return False
        u = ctypes.windll.user32
        h = u.OpenInputDesktop(0, False, 0x0100)
        if not h:
            return False
        u.CloseDesktop(h)
        return True
    except Exception:
        return True


def ntfy_admin_send(cfg, title, text, click=None, topic=None):
    """رسالة للمنظم بس (مكان خاص فيه). ردود الأوامر تنكتب في مكانها (-res-<id>)"""
    def run():
        try:
            t = topic or cfg["admin_topic"]
            e = fb_entry(text, title, click or "", 4)
            fb_req("PUT" if "-res-" in t else "POST", fb_path(t), e)
            net_ok()
        except Exception as ex:
            net_err(ex)
    threading.Thread(target=run, daemon=True).start()


def ntfy_publish_raw(topic, body):
    """قيمة وحدة تنكتب فوق القديمة (حالة اللاعبين، الأسماء)"""
    def run():
        try:
            fb_req("PUT", fb_path(topic), fb_entry(body))
            net_ok()
        except Exception as ex:
            net_err(ex)
    threading.Thread(target=run, daemon=True).start()


def fb_items(data):
    """[(id, الرسالة, الوقت بالثواني)] من قائمة Firebase"""
    out = []
    for k, v in (data or {}).items() if isinstance(data, dict) else []:
        if isinstance(v, dict) and "m" in v:
            out.append((k, v.get("m", ""), float(v.get("t", 0)) / 1000))
    return sorted(out, key=lambda x: x[2])


def ntfy_poll(topic, since):
    """يرجع الرسائل اللي وصلت للقناة من وقت معين"""
    try:
        return [m for _, m, t in fb_items(fb_req("GET", fb_path(topic))) if t >= since - 5]
    except Exception:
        return []


def fb_cleanup(cfg):
    """نمسح القديم عشان القاعدة تبقى صغيرة: الردود بعد يوم، والأوامر والرسائل بعد 8 أيام"""
    now = time.time()
    for topic, keep in ((cfg["admin_topic"] + "-ok", 8 * 86400), (cfg["admin_topic"] + "-res-x", 86400), (cfg["admin_topic"] + "-voice", 86400),
                        (cfg["admin_topic"], 8 * 86400), (cfg.get("ntfy_topic", ""), 8 * 86400)):
        if not topic:
            continue
        path = fb_path(topic).rsplit("/", 1)[0] if "-res-" in topic else fb_path(topic)
        try:
            old = {k: None for k, _, t in fb_items(fb_req("GET", path)) if t < now - keep}
            if old:
                fb_req("PATCH", path, old)
        except Exception:
            pass


def _png(w, h, rgb):
    """صورة PNG بدون مكتبات إضافية"""
    import zlib
    import struct
    row = w * 3
    raw = b"".join(b"\x00" + bytes(rgb[y * row:(y + 1) * row]) for y in range(h))

    def chunk(kind, data):
        c = kind + data
        return struct.pack(">I", len(data)) + c + struct.pack(">I", zlib.crc32(c) & 0xffffffff)
    return (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
            + chunk(b"IDAT", zlib.compress(raw, 6)) + chunk(b"IEND", b""))


def screen_shot(width=720):
    """صورة صغيرة للشاشة (للبث للكبير). ترجع رابط data: أو None"""
    import base64
    import io
    try:
        if IS_WIN:
            import ctypes
            from ctypes import wintypes
            u, g = ctypes.windll.user32, ctypes.windll.gdi32
            try:
                u.SetThreadDpiAwarenessContext(ctypes.c_void_p(-4))    # الشاشة كاملة بالحجم الحقيقي
            except Exception:
                pass
            sw, sh = u.GetSystemMetrics(0), u.GetSystemMetrics(1)
            w = min(width, sw)
            h = max(1, sh * w // sw)
            src = u.GetDC(0)
            dc = g.CreateCompatibleDC(src)
            bmp = g.CreateCompatibleBitmap(src, w, h)
            g.SelectObject(dc, bmp)
            g.SetStretchBltMode(dc, 4)                                  # HALFTONE: تصغير ناعم
            g.StretchBlt(dc, 0, 0, w, h, src, 0, 0, sw, sh, 0x00CC0020)

            class BIH(ctypes.Structure):
                _fields_ = [("biSize", wintypes.DWORD), ("biWidth", ctypes.c_long), ("biHeight", ctypes.c_long),
                            ("biPlanes", wintypes.WORD), ("biBitCount", wintypes.WORD), ("biCompression", wintypes.DWORD),
                            ("biSizeImage", wintypes.DWORD), ("biXPelsPerMeter", ctypes.c_long),
                            ("biYPelsPerMeter", ctypes.c_long), ("biClrUsed", wintypes.DWORD), ("biClrImportant", wintypes.DWORD)]
            bi = BIH(ctypes.sizeof(BIH), w, -h, 1, 32, 0, 0, 0, 0, 0, 0)
            buf = ctypes.create_string_buffer(w * h * 4)
            g.GetDIBits(dc, bmp, 0, h, buf, ctypes.byref(bi), 0)
            g.DeleteObject(bmp)
            g.DeleteDC(dc)
            u.ReleaseDC(0, src)
            bgra = buf.raw
            try:
                from PIL import Image
                im = Image.frombuffer("RGB", (w, h), bgra, "raw", "BGRX", 0, 1)
                out = io.BytesIO()
                im.save(out, "JPEG", quality=55)
                return "data:image/jpeg;base64," + base64.b64encode(out.getvalue()).decode()
            except Exception:
                rgb = bytearray(w * h * 3)
                rgb[0::3], rgb[1::3], rgb[2::3] = bgra[2::4], bgra[1::4], bgra[0::4]
                return "data:image/png;base64," + base64.b64encode(_png(w, h, rgb)).decode()
        from PIL import ImageGrab                                        # غير ويندوز (للتجربة)
        im = ImageGrab.grab().convert("RGB")
        im = im.resize((width, max(1, im.height * width // im.width)))
        out = io.BytesIO()
        im.save(out, "JPEG", quality=55)
        return "data:image/jpeg;base64," + base64.b64encode(out.getvalue()).decode()
    except Exception:
        return None


# ---- أوقات الصلاة (أم القرى: الفجر 18.5°، العشاء بعد المغرب بساعة ونص، وفي رمضان ساعتين)
def _d(x): return math.degrees(x)
def _r(x): return math.radians(x)
def _fix(a, b): a = a - b * math.floor(a / b); return a + b if a < 0 else a
def _sun(jd):
    D = jd - 2451545.0
    g = _fix(357.529 + 0.98560028 * D, 360); q = _fix(280.459 + 0.98564736 * D, 360)
    L = _fix(q + 1.915 * math.sin(_r(g)) + 0.020 * math.sin(_r(2 * g)), 360)
    e = 23.439 - 0.00000036 * D
    RA = _d(math.atan2(math.cos(_r(e)) * math.sin(_r(L)), math.cos(_r(L)))) / 15
    return _d(math.asin(math.sin(_r(e)) * math.sin(_r(L)))), q / 15 - _fix(RA, 24)
def _hijri_month(d):
    jd = d.toordinal() + 1721425
    l = jd - 1948440 + 10632; n = (l - 1) // 10631; l = l - 10631 * n + 354
    j = ((10985 - l) // 5316) * ((50 * l) // 17719) + (l // 5670) * ((43 * l) // 15238)
    l = l - ((30 - j) // 15) * ((17719 * j) // 50) - (j // 16) * ((15238 * j) // 43) + 29
    return (24 * l) // 709
def prayer_times(day, lat, lng, tz=3):
    jd = day.toordinal() + 1721424.5 - lng / (15 * 24)
    def mid(t): return _fix(12 - _sun(jd + t)[1], 24)
    def angle_time(angle, t, ccw=False):
        decl = _sun(jd + t)[0]
        x = (-math.sin(_r(angle)) - math.sin(_r(decl)) * math.sin(_r(lat))) / (math.cos(_r(decl)) * math.cos(_r(lat)))
        T = _d(math.acos(max(-1, min(1, x)))) / 15
        return mid(t) + (-T if ccw else T)
    def asr(t):
        decl = _sun(jd + t)[0]
        return angle_time(-_d(math.atan(1 / (1 + math.tan(_r(abs(lat - decl)))))), t)
    t = {"fajr": angle_time(18.5, 5 / 24, True), "dhuhr": mid(12 / 24), "asr": asr(13 / 24),
         "maghrib": angle_time(0.833, 18 / 24)}
    t["isha"] = t["maghrib"] + (2.0 if _hijri_month(day) == 9 else 1.5)
    base = datetime.datetime.combine(day, datetime.time())
    return {k: base + datetime.timedelta(hours=v + tz - lng / 15) for k, v in t.items()}

MEDIA_DIR = os.path.join(DATA_DIR, "media")


def fetch_media():
    """صوت الأذان والقرآن وصورة الحرم: تنزل مرة وحدة وتنحفظ عندنا"""
    os.makedirs(MEDIA_DIR, exist_ok=True)
    for name, size in MEDIA_FILES.items():
        path = os.path.join(MEDIA_DIR, name)
        try:
            if os.path.exists(path) and os.path.getsize(path) > 1000 and (not size or os.path.getsize(path) == size):
                continue
            with urllib.request.urlopen(MEDIA_URL + name, timeout=120) as r:
                data = r.read()
            if len(data) > 1000:
                with open(path, "wb") as f:
                    f.write(data)
        except Exception:
            pass


def quran_font():
    """خط «أميري قرآن» (رخصة OFL) للآيات بالرسم العثماني: نحمّله للبرنامج بس (بدون تثبيت في ويندوز)"""
    path = os.path.join(MEDIA_DIR, "AmiriQuran.ttf")
    if not os.path.exists(path):
        return None
    if IS_WIN:
        try:
            import ctypes
            if ctypes.windll.gdi32.AddFontResourceExW(path, 0x10, 0) > 0:    # FR_PRIVATE
                return "Amiri Quran"
        except Exception:
            return None
        return None
    return "Amiri Quran"


def mci(cmd):
    """تشغيل mp3 في ويندوز بدون مكتبات (MCI)"""
    import ctypes
    buf = ctypes.create_unicode_buffer(256)
    ctypes.windll.winmm.mciSendStringW(cmd, buf, 255, 0)
    return buf.value


def machine_id():
    """رقم ثابت للجهاز من ويندوز (ما يتغير لو انحذفت ملفات البرنامج)"""
    if IS_WIN:
        try:
            import winreg
            k = winreg.OpenKey(winreg.HKEY_LOCAL_MACHINE, r"SOFTWARE\Microsoft\Cryptography", 0,
                               winreg.KEY_READ | 0x0100)
            return str(winreg.QueryValueEx(k, "MachineGuid")[0])
        except Exception:
            pass
    return socket.gethostname()


