{"t": 64.3, "v": 13, "text": "ثُمَّ جَعَلۡنَٰهُ نُطۡفَةࣰ فِي قَرَارࣲ مَّكِينࣲ ۝١٣", "simple": "ثُمَّ جَعَلْنَٰهُ نُطْفَةً فِي قَرَارٍ مَّكِينٍ ﴿١٣﴾"}, {"t": 72.78, "v": 14, "text": "ثُمَّ خَلَقۡنَا ٱلنُّطۡفَةَ عَلَقَةࣰ فَخَلَقۡنَا ٱلۡعَلَقَةَ", "simple": "ثُمَّ خَلَقْنَا النُّطْفَةَ عَلَقَةً فَخَلَقْنَا الْعَلَقَةَ"}, {"t": 78.56, "v": 14, "text": "مُضۡغَةࣰ فَخَلَقۡنَا ٱلۡمُضۡغَةَ عِظَٰمࣰا فَكَسَوۡنَا", "simple": "مُضْغَةً فَخَلَقْنَا الْمُضْغَةَ عِظَٰمًا فَكَسَوْنَا"}, {"t": 83.46, "v": 14, "text": "ٱلۡعِظَٰمَ لَحۡمࣰا ثُمَّ أَنشَأۡنَٰهُ خَلۡقًا ءَاخَرَۚ", "simple": "الْعِظَٰمَ لَحْمًا ثُمَّ أَنشَأْنَٰهُ خَلْقًا ءَاخَرَ"}, {"t": 99.07, "v": 14, "text": "فَتَبَارَكَ ٱللَّهُ أَحۡسَنُ ٱلۡخَٰلِقِينَ ۝١٤", "simple": "فَتَبَارَكَ اللَّهُ أَحْسَنُ الْخَٰلِقِينَ ﴿١٤﴾"}, {"t": 103.3, "v": 15, "text": "ثُمَّ إِنَّكُم بَعۡدَ ذَٰلِكَ لَمَيِّتُونَ ۝١٥", "simple": "ثُمَّ إِنَّكُم بَعْدَ ذَٰلِكَ لَمَيِّتُونَ ﴿١٥﴾"}, {"t": 108.51, "v": 16, "text": "ثُمَّ إِنَّكُمۡ يَوۡمَ ٱلۡقِيَٰمَةِ تُبۡعَثُونَ ۝١٦", "simple": "ثُمَّ إِنَّكُمْ يَوْمَ الْقِيَٰمَةِ تُبْعَثُونَ ﴿١٦﴾"}, {"t": 113.43, "v": 17, "text": "وَلَقَدۡ خَلَقۡنَا فَوۡقَكُمۡ سَبۡعَ طَرَآئِقَ", "simple": "وَلَقَدْ خَلَقْنَا فَوْقَكُمْ سَبْعَ طَرَآئِقَ"}, {"t": 118.35, "v": 17, "text": "وَمَا كُنَّا عَنِ ٱلۡخَلۡقِ غَٰفِلِينَ ۝١٧", "simple": "وَمَا كُنَّا عَنِ الْخَلْقِ غَٰفِلِينَ ﴿١٧﴾"}, {"t": 132.16, "v": 18, "text": "وَأَنزَلۡنَا مِنَ ٱلسَّمَآءِ مَآءَۢ بِقَدَرࣲ", "simple": "وَأَنزَلْنَا مِنَ السَّمَآءِ مَآءَ بِقَدَرٍ"}, {"t": 137.78, "v": 18, "text": "فَأَسۡكَنَّـٰهُ فِي ٱلۡأَرۡضِۖ", "simple": "فَأَسْكَنَّـٰهُ فِي الْأَرْضِ"}, {"t": 140.51, "v": 18, "text": "وَإِنَّا عَلَىٰ ذَهَابِۭ بِهِۦ لَقَٰدِرُونَ ۝١٨", "simple": "وَإِنَّا عَلَىٰ ذَهَابِ بِهِۦ لَقَٰدِرُونَ ﴿١٨﴾"}, {"t": 145.19, "v": 19, "text": "فَأَنشَأۡنَا لَكُم بِهِۦ جَنَّـٰتࣲ مِّن", "simple": "فَأَنشَأْنَا لَكُم بِهِۦ جَنَّـٰتٍ مِّن"}, {"t": 150.37, "v": 19, "text": "نَّخِيلࣲ وَأَعۡنَٰبࣲ لَّكُمۡ فِيهَا", "simple": "نَّخِيلٍ وَأَعْنَٰبٍ لَّكُمْ فِيهَا"}, {"t": 154.1